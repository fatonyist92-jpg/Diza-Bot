{
  "name": "diza-bot",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/healthz"
    ]
  },
  "vars": {
    "DIZA_BACKEND_ORIGIN": "https://diza-bot-5eoll.faable.link"
  }
}
